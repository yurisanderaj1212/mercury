{
  "name": "database",
  "version": "0.1.0",
  "private": true,
  "description": "Mercury database schema, migrations and seeds",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --project tsconfig.json seed/seed.ts",
    "indexes": "psql $DATABASE_URL -f migrations/manual/search_indexes.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
