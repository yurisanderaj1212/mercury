# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mercury:mercury_local@localhost:5432/mercury_dev"

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── Auth JWT ────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-string-of-at-least-32-chars"
JWT_EXPIRY="86400"

# ─── IA ──────────────────────────────────────────────────────────────────────
AI_PROVIDER="openai"
AI_API_KEY="sk-..."

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="mercury@example.com"
SMTP_PASSWORD="change-me"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_BASE_URL="http://localhost:3001"
PORT="3001"
